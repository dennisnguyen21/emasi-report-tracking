rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Cho phép đọc và ghi dữ liệu nếu người dùng đã đăng nhập (Authenticated Only)
      // Giúp Firestore không bao giờ hết hạn và bảo mật dữ liệu của bạn.
      allow read, write: if request.auth != null;
    }
  }
}
